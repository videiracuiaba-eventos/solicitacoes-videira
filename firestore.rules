rules_version = '2';

// Regras de acesso do site de Solicitações da Igreja Videira.
// - Só entra quem tem cadastro em /usuarios criado pelo administrador e está ativo.
// - Pastor lê e cria apenas as próprias solicitações; só pode acrescentar a nota fiscal depois.
// - Administrador (papel "admin") lê tudo, aprova, recusa e cadastra pastores.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function temPerfil() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function ativo() { return temPerfil() && perfil().ativo == true; }
    function admin() { return ativo() && perfil().papel == 'admin'; }
    function dono() { return ativo() && resource.data.uid == request.auth.uid; }

    match /usuarios/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow write: if admin();
    }

    match /solicitacoes/{id} {
      allow read: if admin() || dono();
      allow create: if ativo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente';
      allow update: if admin()
        || (dono() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['notaFiscal', 'nfEnviadaEm']));
      allow delete: if admin();
    }

    match /arquivos/{id} {
      allow read: if admin() || dono();
      allow create: if ativo() && request.resource.data.uid == request.auth.uid;
      allow delete: if admin();

      match /partes/{parte} {
        allow read: if admin() || dono();
        allow create: if ativo() && request.resource.data.uid == request.auth.uid;
        allow delete: if admin();
      }
    }
  }
}
